<?xml version="1.0"?>
<odoo noupdate="1">

    <record model="ir.sequence" id="seq_job">
        <field name="name">Job Code</field>
        <field name="code">job.job</field>
        <field name="prefix">JOB%(year)s%(month)s</field>
        <field eval="1" name="number_next"/>
        <field eval="1" name="number_increment"/>
        <field eval="True" name="use_date_range"/>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
