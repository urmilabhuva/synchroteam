<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Custom Field Value -->
        <record id="view_custom_field_value_tree" model="ir.ui.view">
            <field name="name">custom.field.value.tree</field>
            <field name="model">custom.field.value</field>
            <field name="arch" type="xml">
                <tree string="Custom Field Values">
                    <field name="name"/>
                    <field name="value"/>
                </tree>
            </field>
        </record>

        <record id="view_custom_field_value_form" model="ir.ui.view">
            <field name="name">custom.field.value.form</field>
            <field name="model">custom.field.value</field>
            <field name="arch" type="xml">
                <form string="Custom Field Value">
                    <group col="4">
                        <field name="name"/>
                        <field name="value"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="action_custom_field_value_model" model="ir.actions.act_window">
            <field name="name">Custom Field Values</field>
            <field name="res_model">custom.field.value</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_custom_field_value_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Custom Field Values
                </p>
            </field>
        </record>

        <record id="view_custom_field_tree" model="ir.ui.view">
            <field name="name">custom.field.tree</field>
            <field name="model">custom.field</field>
            <field name="arch" type="xml">
                <tree string="Custom Field">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="view_custom_field_form" model="ir.ui.view">
            <field name="name">custom.field.form</field>
            <field name="model">custom.field</field>
            <field name="arch" type="xml">
                <form string="Custom Field">
                    <group>
                        <field name="name"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="action_custom_field_model" model="ir.actions.act_window">
            <field name="name">Custom Fields</field>
            <field name="res_model">custom.field</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_custom_field_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Custom Field Values
                </p>
            </field>
        </record>

    </data>
</odoo>