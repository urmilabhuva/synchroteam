<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_sale_order_line" model="ir.actions.act_window">
            <field name="name">Order Line(s)</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sale.order.line</field>
            <field name="view_mode">tree,form</field>
            <!-- <field name="view_type">form</field> -->
            <field name="context">{'default_job_id': active_id}</field>
            <field name="domain">[('job_id', '=', active_id)]</field>
        </record>

        <record id="action_purchase_order" model="ir.actions.act_window">
            <field name="name">Purchase Order(s)</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">purchase.order</field>
            <field name="view_mode">tree,form</field>
            <!-- <field name="view_type">form</field> -->
            <field name="context">{'default_job_id': active_id}</field>
            <field name="domain">[('job_id', '=', active_id)]</field>
        </record>

        <record id="action_stock_picking" model="ir.actions.act_window">
            <field name="name">Stock Picking(s)</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">stock.picking</field>
            <field name="view_mode">tree,form</field>
            <!-- <field name="view_type">form</field> -->
            <field name="context">{'default_job_id': active_id}</field>
            <field name="domain">[('job_id', '=', active_id)]</field>
        </record>

        <record id="action_mrp_production" model="ir.actions.act_window">
            <field name="name">Manufacturing Order(s)</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mrp.production</field>
            <field name="view_mode">tree,form</field>
            <!-- <field name="view_type">form</field> -->
            <field name="context">{'default_job_id': active_id}</field>
            <field name="domain">[('job_id', '=', active_id)]</field>
        </record>

        <record id="action_project_task" model="ir.actions.act_window">
            <field name="name">Tasks(s)</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">project.task</field>
            <field name="view_mode">tree,form</field>
            <!-- <field name="view_type">form</field> -->
            <field name="context">{'default_job_id': active_id}</field>
            <field name="domain">[('job_id', '=', active_id)]</field>
        </record>

        <!-- Job Job -->
        <record id="job_job_tree" model="ir.ui.view">
            <field name="name">job.job.tree</field>
            <field name="model">job.job</field>
            <field name="arch" type="xml">
                <tree decoration-info="status == 'draft'" decoration-muted="status == 'validated'" string="Job">
                    <field name="partner_id" groups="base.group_user" string="Customer"/>
                    <field name="name"/>
                    <field name="client_order_ref"/>
                    <field name="description"/>
                    <field name="order_id"/>
                    <field name="site_id"/>
                    <field name="job_type_id"/>
                    <field name="mechanic"/>
                    <field name="priority"/>
                    <field name="schedule_start_date" string="Job Start date"/>
                    <field name="status"/>
                    <field name="job_in_alert"/>
                </tree>
            </field>
        </record>


        <record id="job_job_form" model="ir.ui.view">
            <field name="name">job.job.form</field>
            <field name="model">job.job</field>
            <field name="arch" type="xml">
                <form string="Job" class="o_invoice_form">
                    <header>
                        <button name="set_draft" string="Set to Draft" class="oe_highlight" type="object" attrs="{'invisible': [('status', 'not in', ('cancelled'))]}"/>
                        <button name="set_to_cancel" string="Cancel" type="object" attrs="{'invisible': [('status', '=', 'cancelled')]}"/>
                        <button name="run_st_schedule_action" string="Get ST Status" class="oe_highlight" type="object" attrs="{'invisible': [('status', 'in', ('draft','validated'))]}"/>
                        <button name="run_check_release_st_job" string="Release to ST" class="oe_highlight" type="object" attrs="{'invisible': [('status', 'not in', ('scheduled'))]}"/>
                        <button name="action_job_send" class="oe_highlight" string="Send by Email" type="object"/>
                        <field name="status" widget="statusbar" statusbar_visible="draft,created,scheduled,synchronized,started,paused,completed,validated,cancelled,exception"/>
                    </header>
                    <sheet string="Job">
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" icon="fa-signal" type="object" name="get_sale_order">
                                <field name="sale_order_line_count" string="Sale Order Line(s)" widget="statinfo" />
                            </button>
                            <button class="oe_stat_button" icon="fa-credit-card" type="action" name="%(action_purchase_order)d">
                                <field name="purchase_count" string="Purchase Order(s)" widget="statinfo" />
                            </button>
                            <button class="oe_stat_button" icon="fa-truck" type="action" name="%(action_stock_picking)d">
                                <field name="stock_picking_count" string="Stock Picking(s)" widget="statinfo" />
                            </button>
                            <button class="oe_stat_button" icon="fa-wrench" type="action" name="%(action_mrp_production)d">
                                <field name="manufacture_count" string="Manufacturing Order(s)" widget="statinfo" />
                            </button>
                            <button class="oe_stat_button" icon="fa-tasks" type="action" name="%(action_project_task)d">
                                <field name="task_count" string="Task(s)" widget="statinfo" />
                            </button>
                            <button class="oe_stat_button" icon="fa-tasks" type="object" name="get_helpdesk_ticket" attrs="{'invisible': [('ticket_count', '=', 0)]}">
                                <field name="ticket_count" string="Tickets)" widget="statinfo" />
                            </button>
                        </div>
                        <div>
                            <h1>
                                <field name="name" readonly="1" class="oe_inline"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="template_id" attrs="{'readonly': [('status', 'not in', ['draft'])]}"/>
                                <field name="description" required="1" attrs="{'readonly': [('status', 'not in', ['draft'])]}"/>
                                <field name="partner_id" attrs="{'readonly': [('status', 'not in', ['draft'])]}"/>
                                <field name="site_id" attrs="{'readonly': [('status', 'not in', ['draft'])]}"/>
                                <field name="delivery_address" attrs="{'readonly': [('status', 'not in', ['draft'])]}"/>
                            </group>
                            <group>
                                <field name="mechanic" readonly="1"/>
                                <field name="validation_user_id" readonly="1"/>
                                <field name="priority" widget="selection" attrs="{'readonly': [('status', 'not in', ['draft'])]}"/>
                                <field name="client_order_ref"/>
                                <field name="order_id" attrs="{'readonly': [('status', 'not in', ['cancelled','exception'])]}"/>
                                <field name="require_approval" attrs="{'readonly': [('status', 'not in', ['draft'])]}"/>
                            </group>
                        </group>
                        <notebook colspan="4">
                            <page string="General" name="general">
                                <group string="General">
                                    <field name="job_type_id" attrs="{'readonly': [('status', 'not in', ['draft'])]}"/>
                                    <field name="job_in_alert"/>
                                    <field name="public_link" widget="url"/>
                                    <field name="picking_notes"/>
                                </group>
                                <group string="Settings">
                                    <!--<field name="duration" attrs="{'readonly': [('status', 'not in', ['0'])]}"/>-->
                                    <!-- <field name="technician_ids" widget="many2many_tags" readonly="1"/> -->
                                    <field name="product_ids" widget="many2many_tags" readonly="1"/>
                                    <field name="custom_field_ids" widget="many2many_tags" attrs="{'readonly': [('status', 'not in', ['draft'])]}" domain="[('job_id', '=', False)]" invisible="1"/>
                                    <field name="tag_ids" widget="many2many_tags" invisible="1"/>
                                </group>
                                <group string="Planning">
                                    <field name="estimation_date" attrs="{'readonly': [('status', 'not in', ['draft'])]}"/>
                                    <field name="schedule_start_date" readonly="1"/>
                                    <field name="schedule_end_date" readonly="1"/>
                                    <field name="actual_start_date" readonly="1"/>
                                    <field name="actual_end_date" readonly="1"/>
                                </group>
                            </page>
                            <page string="Address Detail" name="address_detail">
                                <group>
                                    <group>
                                        <field name="address" readonly="0"/>
                                        <field name="street" readonly="0"/>
                                        <field name="street2" readonly="0"/>
                                        <field name="zip" readonly="0"/>
                                        <field name="city" readonly="0"/>
                                        <field name="state_id" readonly="0"/>
                                        <field name="country_id" readonly="0"/>
                                    </group>
                                    <group>
                                        <field name="contact_firstname"/>
                                        <field name="contact_lastname"/>
                                        <field name="contact_phone" readonly="0"/>
                                        <field name="contact_mobile" readonly="0"/>
                                        <field name="contact_email" readonly="0"/>
                                        <field name="partner_latitude" readonly="1"/>
                                        <field name="partner_longitude" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Report Detail" name="report_detail">
                                <group>
                                    <field name="st_notes"/>
                                    <field name="payload_stored" invisible="0" readonly="1"/>
                                    <field name="response_stored" invisible="0"  readonly="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>

        </record>

        <record id="view_job_job_filter" model="ir.ui.view">
            <field name="name">job.job.select</field>
            <field name="model">job.job</field>
            <field name="arch" type="xml">
                <search string="Search Job">
                    <field name="name" string="Name" filter_domain="[('name','ilike',self)]"/>
                    <filter domain="[('create_uid','=',uid)]" name="myjobs" help="My Jobs"/>
                    <separator/>
                    <filter name="job_in_alert" string="Job in Alert" domain="[('job_in_alert','=', True)]"/>
                    <filter name="created" string="Created" domain="[('status','=','draft')]"/>
                    <filter name="scheduled" string="Scheduled" domain="[('status', '=', 'scheduled')]"/>
                    <filter name="completed" string="Completed" domain="[('status', '=', 'completed')]"/>
                    <filter name="validate" string="Validated" domain="[('status', '=', 'validated')]"/>
                    <filter name="late" string="Overdue" domain="['&amp;', ('estimation_date', '&lt;', time.strftime('%%Y-%%m-%%d')), ('status', '=', 'scheduled')]" help="Overdue Job, maturity date passed"/>
                    <separator/>
                    <field name="order_id"/>
                    <field name="partner_id" operator="child_of"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_type_id" string="Type" context="{'group_by':'job_type_id'}"/>
                        <filter name="mechanic" string="Mechanic" context="{'group_by':'mechanic'}"/>
                        <filter name="status" string="Status" context="{'group_by':'status'}"/>
                        <separator/>
                        <filter string="Job Date" name="jobdate" context="{'group_by':'estimation_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_job_job_calendar" model="ir.ui.view">
            <field name="name">job.job.calendar</field>
            <field name="model">job.job</field>
            <field name="arch" type="xml">
                <calendar string="Jobs" date_start="estimation_date" color="order_id">
                    <field name="partner_id"/>
                </calendar>
            </field>
        </record>

        <record id="action_job_model" model="ir.actions.act_window">
            <field name="name">Jobs</field>
            <field name="res_model">job.job</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form,calendar,pivot,graph</field>
            <field eval="False" name="view_id"/>
            <field name="search_view_id" ref="view_job_job_filter"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Job.
                </p>
            </field>
        </record>

    </data>
</odoo>