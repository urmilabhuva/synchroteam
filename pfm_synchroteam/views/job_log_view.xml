<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
		<record id="job_log_form" model="ir.ui.view">
            <field name="name">job.log.form</field>
            <field name="model">synchroteam.log</field>
            <field name="arch" type="xml">
                <form string="Job Log" create="false">
                	<sheet string="Job Log">
                		<group>
                            <group>
                            	<field name="record_id"/>
                            	<field name="record_obj"/>
                            	<field name="request_url"/>
                            </group>
                           	<group>
                           		<field name="datetime"/>
                            	<field name="record_method"/>
                           	</group>
                        </group>
                	</sheet>
                </form>
            </field>
        </record>

        <record id="job_log_tree" model="ir.ui.view">
            <field name="name">job.log.tree</field>
            <field name="model">synchroteam.log</field>
            <field name="arch" type="xml">
                <tree string="Job Log" create="false">
                    <field name="record_id"/>
                    <field name="record_obj"/>
                    <field name="datetime"/>
                    <field name="record_method"/>
                    <field name="request_url"/>
                </tree>
            </field>
        </record>

        <record id="action_job_log_model" model="ir.actions.act_window">
            <field name="name">Job Logs</field>
            <field name="res_model">synchroteam.log</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="job_log_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Job Log.
                </p>
            </field>
        </record>
    </data>
</odoo>