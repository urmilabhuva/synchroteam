<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Job Type -->
        <record id="view_job_type_tree" model="ir.ui.view">
            <field name="name">job.type.tree</field>
            <field name="model">job.type</field>
            <field name="arch" type="xml">
                <tree string="Job Types">
                    <field name="name"/>
                    <field name="st_job_type_id" invisible="True"/>
                    <field name="sent_to_st"/>
                </tree>
            </field>
        </record>

        <record id="view_job_type_form" model="ir.ui.view">
            <field name="name">job.type.form</field>
            <field name="model">job.type</field>
            <field name="arch" type="xml">
                <form string="Job Type">
                    <group col="4">
                        <field name="name"/>
                        <field name="st_job_type_id"/>
                        <field name="sent_to_st"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="action_job_type_model" model="ir.actions.act_window">
            <field name="name">Job types</field>
            <field name="res_model">job.type</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_job_type_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Job type
                </p>
            </field>
        </record>

    </data>
</odoo>