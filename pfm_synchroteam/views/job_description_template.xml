<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Job Tag -->
        <record id="view_job_description_template_tree" model="ir.ui.view">
            <field name="name">job.description.template.tree</field>
            <field name="model">job.description.template</field>
            <field name="arch" type="xml">
                <tree string="Job Templates">
                    <field name="name"/>
                    <field name="description"/>
                </tree>
            </field>
        </record>

        <record id="view_job_description_template_form" model="ir.ui.view">
            <field name="name">job.description.template.form</field>
            <field name="model">job.description.template</field>
            <field name="arch" type="xml">
                <form string="Job Template">
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="action_job_description_template_model" model="ir.actions.act_window">
            <field name="name">Job Templates</field>
            <field name="res_model">job.description.template</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_job_description_template_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a Job Template
                </p>
            </field>
        </record>

    </data>
</odoo>